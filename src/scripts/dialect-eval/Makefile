install:
	./scripts/setup_venv.sh

eval-gpt:
	python cli.py remote --model gpt-4o-mini

eval-gemini:
	python cli.py remote --model google/gemini-2.0-flash-001

eval-mistral:
	python cli.py remote --model mistralai/mistral-large-2411

eval-mamay:
	python cli.py local --model INSAIT-Institute/MamayLM-Gemma-3-4B-IT-v1.0

eval-lapa:
	python cli.py local --model lapa-llm/lapa-v0.1.2-instruct
